# LipScribe backend: the variables Coolify needs (resource -> Environment Variables). Copy to
# backend/.env (not in git) and fill in DEMO_CODE; never put a real code in this file.
# Paste each line into Coolify, or use Coolify's "Developer view" and paste the whole block.
# The compose file also reads this file when run by hand: docker compose -f backend/docker-compose.yml up -d

# Access code the page must send (?code=...). Mark it "Is Secret" in Coolify.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(9))"
DEMO_CODE=change-me

# Sites allowed to call the backend over HTTP. Replace lipscribe-api.ucu-dct.org with the real
# backend domain once it exists (DEPLOYMENT.md step 6); add a custom page domain here if you add one.
DEMO_ORIGINS=https://lipscribe.pages.dev,https://lipscribe-api.ucu-dct.org

# Which model pairs to load: any,grid (both), any (open speech only) or grid (GRID only).
DEMO_MODELS=any,grid
