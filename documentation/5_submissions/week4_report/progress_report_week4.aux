\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Screenshots of the web demo. \textbf  {Left:} \emph  {GRID sentences} mode (P4 + GRID grammar) writes \textbf  {``bin blue at j five please''}, exactly the spoken sentence, in 3.3\,s. The face was found in 100\,\% of frames, and the model gave the lips 25\,\% of the trust (clean audio). \textbf  {Right:} \emph  {Any speech (experimental)} mode on the same clip writes ``i these'': the film-trained model has forgotten GRID (Table~\ref {tab:flix}) and leans almost entirely on the sound (lips 1\,\%).}}{10}{figure.caption.14}\protected@file@percent }
\newlabel{fig:demo}{{8}{10}{Screenshots of the web demo. \textbf {Left:} \emph {GRID sentences} mode (P4 + GRID grammar) writes \textbf {``bin blue at j five please''}, exactly the spoken sentence, in 3.3\,s. The face was found in 100\,\% of frames, and the model gave the lips 25\,\% of the trust (clean audio). \textbf {Right:} \emph {Any speech (experimental)} mode on the same clip writes ``i these'': the film-trained model has forgotten GRID (Table~\ref {tab:flix}) and leans almost entirely on the sound (lips 1\,\%)}{figure.caption.14}{}}
