% Shared style for LipScribe project-management documents
% (same look as the implementation document).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lipscribe-report}

\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
\fi
\RequirePackage{lmodern}
\RequirePackage{microtype}
\setlength{\emergencystretch}{3em}

\RequirePackage[a4paper,margin=2.3cm,headheight=14pt]{geometry}
\RequirePackage{setspace}
\setstretch{1.1}
\RequirePackage[parfill]{parskip}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\setlist{itemsep=1pt,topsep=3pt}
\RequirePackage{amssymb}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}p{#1}}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage[table]{xcolor}
\RequirePackage[font=small,labelfont={bf,sf},skip=6pt]{caption}
\RequirePackage{tikz}
\usetikzlibrary{positioning,calc}
\RequirePackage[hidelinks]{hyperref}

\definecolor{lsblue}{RGB}{31,73,125}
\definecolor{lsgrey}{RGB}{110,110,110}
\definecolor{lsdone}{RGB}{56,118,29}
\definecolor{lsprog}{RGB}{191,120,0}
\definecolor{lsplan}{RGB}{110,110,110}
\definecolor{lslight}{RGB}{220,230,242}
\definecolor{lsrow}{RGB}{245,247,250}

\titleformat{\section}{\large\sffamily\bfseries\color{lsblue}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\normalsize\sffamily\bfseries\color{lsblue}}{\thesubsection}{0.7em}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}

\newcommand{\done}{\textcolor{lsdone}{\sffamily\bfseries Done}}
\newcommand{\inprog}{\textcolor{lsprog}{\sffamily\bfseries In progress}}
\newcommand{\planned}{\textcolor{lsplan}{\sffamily Planned}}

