# LaTeX build outputs (reports and documents under docs/)
docs/**/*.aux
docs/**/*.log
docs/**/*.toc
docs/**/*.lof
docs/**/*.lot
docs/**/*.loa
docs/**/*.out
docs/**/*.fls
docs/**/*.fdb_latexmk
docs/**/*.synctex.gz
docs/2_implementation/implementation_document/main.pdf

# Downloaded papers for the related-work section (kept locally, not in git)
docs/5_submissions/final_report/papers/

# Office lock files created while a document is open
~$*

# LipScribe: data and raw media (anchored to repo root)
/Data/*
/data/*
!/data/splits.csv
!/data/noise_splits.csv
/recordings/
/gridcorpus/
audio_processing/processed/audio16k/s*/

# Heavy binary artifacts
*.npy
*.pt
*.wav
*.mp4
*.avi
*.mpg
checkpoints/

# Allow tiny test fixtures
!tests/fixtures/*.npy
!tests/fixtures/*.wav

# Runs: allow tracking epoch history CSV, learning curves, and configs; ignore heavy checkpoints
/runs/**/*.pt
/runs/**/*.tmp
/runs/**/tensorboard/

# Models and pretrained weights (mounted into the backend container, never in git)
/models/
/pretrained/
/lm/

# Backend runtime files (backend/run_local.sh)
/logs/
.demo_code
.demo_url
.demo_no_tunnel
.env

# Environments and editor files
.venv/
.venv311/
.idea/
.DS_Store

# Python build artifacts
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/

# Scratch/download artifacts not part of the repo
tectonic.zip

# Local AI-assistant settings
.claude/
