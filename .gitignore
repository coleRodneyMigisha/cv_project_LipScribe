# LaTeX build outputs
documentation/**/*.aux
documentation/**/*.log
documentation/**/*.toc
documentation/**/*.lof
documentation/**/*.lot
documentation/**/*.loa
documentation/**/*.out
documentation/**/*.fls
documentation/**/*.fdb_latexmk
documentation/**/*.synctex.gz
documentation/2_implementation/implementation_document/main.pdf

# Office lock files created while a document is open
~$*

# LipScribe: data and raw media (anchored to repo root)
/Data/*
/data/*
!/data/splits.csv
!/data/noise_splits.csv
/recordings/
/gridcorpus/
audio_processing/processed/audio16k/s*/

# Heavy binary artifacts
*.npy
*.pt
*.wav
*.mp4
*.avi
*.mpg
checkpoints/

# Allow tiny test fixtures
!tests/fixtures/*.npy
!tests/fixtures/*.wav

# Runs: allow tracking epoch history CSV, learning curves, and configs; ignore heavy checkpoints
/runs/**/*.pt
/runs/**/*.tmp
/runs/**/tensorboard/

# Environments and editor files
.venv/
.venv311/
.idea/
.DS_Store

# Python build artifacts
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/

# Models
/models/
